        <mxCell id="nVFVpwAe7lqRvnvSEs3c-5" value="&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;**Description:**&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;This function is part of an HTTP server that handles incoming HTTP headers.&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;The goal is to verify if the incoming header is fully received and process&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;the valid portion of it. Any remaining unused data should be retained for&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;subsequent processing.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;**Context:**&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;- acceptable_http_headers: list[bytes], a set of permissible HTTP header&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;versions like [&quot;HTTP/1.1&quot;] to ensure compatibility.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;**Function Name:** `process_http_request`&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;**Arguments:**&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;- request_data: bytes, the raw incoming network data that contains or partially&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;contains an HTTP header.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;**Returns:**&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;bytes, the remaining part of the buffer after processing the valid HTTP header.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;**Raises:**&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;- ValueError: if the HTTP header is incomplete or invalid, or if processing fails.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;**Setup**:&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;The following setup code has already been provided. You should use this in the&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;beginning of your code.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&amp;lt;code&amp;gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;acceptable_http_headers = [b&quot;HTTP/1.1&quot;]&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&amp;lt;/code&amp;gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Important: Write your reasoning steps within &amp;lt;think&amp;gt; and &amp;lt;/think&amp;gt; tags.&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;And wrap your final code implementation within &amp;lt;code&amp;gt; and &amp;lt;/code&amp;gt; tags.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Example format:&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&amp;lt;think&amp;gt;Your reasoning steps here...&amp;lt;/think&amp;gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&amp;lt;code&amp;gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Your final code implementation here...&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot; style=&quot;color: rgb(0, 0, 0);&quot; color=&quot;#cccccc&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&amp;lt;/code&amp;gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
