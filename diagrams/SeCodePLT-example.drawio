        <mxCell id="nVFVpwAe7lqRvnvSEs3c-11" value="&lt;font face=&quot;Menlo, Monaco, Courier New, monospace&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&amp;lt;code&amp;gt;&lt;br/&gt;acceptable_http_headers = [b&quot;HTTP/1.1&quot;]&lt;br/&gt;&lt;br/&gt;def process_http_request(request_data: bytes):&lt;br/&gt;&lt;br/&gt;    if request_data.find(b&quot;\r\n\r\n&quot;) == -1:&lt;br/&gt;        raise ValueError(&quot;No complete HTTP header found&quot;)&lt;br/&gt;&lt;br/&gt;    headers = request_data.split(b&quot;\r\n&quot;)&lt;br/&gt;    for line in headers:&lt;br/&gt;        if line.startswith(b&quot;HTTP/&quot;):&lt;br/&gt;            headerVersion = line.split(b&quot; &quot;)[0]&lt;br/&gt;            if headerVersion not in acceptable_http_headers:&lt;br/&gt;                raise ValueError(f&quot;Unsupported HTTP version: {headerVersion}&quot;)&lt;br/&gt;            i = headers.index(line)&lt;br/&gt;            request_data = b&quot;\r\n&quot;.join(headers[i + 1:])&lt;br/&gt;            return request_data&lt;br/&gt;&lt;br/&gt;    return request_data&lt;br/&gt;&amp;lt;/code&amp;gt;&lt;/span&gt;&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="1950" y="1870" width="560" height="300" as="geometry" />
